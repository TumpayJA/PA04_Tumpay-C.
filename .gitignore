# ============================================================
#  .gitignore para proyecto Unity 6 - ESCAPE (PA4 Videojuegos)
#  Ponlo en la RAIZ del proyecto (al lado de Assets/, Packages/ y ProjectSettings/)
#
#  IMPORTANTE: NO se ignoran los archivos .meta, ni las carpetas
#  Assets/, Packages/ y ProjectSettings/. Esos SI deben subirse:
#  ahi esta el juego ya creado (escenas, prefabs, NavMesh, luces,
#  lista de escenas del Build, etc.).
# ============================================================

# --- Carpetas que Unity regenera sola (NO se suben) ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# --- Builds (el .exe se entrega aparte: GitHub Releases o Drive) ---
/[Bb]uild/
/[Bb]uilds/
*.apk
*.aab
*.unitypackage
*.app

# --- Archivos generados por el editor de codigo ---
/.vs/
/.vscode/
/.idea/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# --- Otros ---
crashlytics-build.properties
sysinfo.txt
*.log

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini
